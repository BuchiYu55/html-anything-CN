{
  "name": "html-anything-desktop",
  "version": "0.1.0",
  "description": "Windows desktop shell for html-anything (fork with 4 upstream fixes) — Electron sidecar over the Next standalone server, no Node.js required",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "electron-winstaller", "esbuild"]
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.songyike.htmlanything",
    "productName": "html-anything",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "../next/.next/standalone",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
